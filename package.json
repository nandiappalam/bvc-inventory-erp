{
  "name": "bvc-erp",
  "version": "1.0.0",
  "description": "BVC ERP - Purchase Management System (Standalone Desktop Application)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "tauri": "tauri",
    "frontend": "npm --workspace frontend run dev -- --host 0.0.0.0 --port 5173",
    "backend": "set PORT=3001&& node backend/server.js",
    "desktop:dev": "concurrently --kill-others-on-fail --names API,UI \"npm run backend\" \"npm run frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend",
    "dev": "npm run desktop:dev",
    "start": "node backend/server.js",
    "lint": "cd frontend && npm run lint"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.6.3",
    "@types/node": "^25.9.2",
    "concurrently": "^9.2.4"
  },
  "author": "",
  "license": "MIT"
}
