{
  "name": "bvc-erp",
  "version": "1.0.0",
  "description": "BVC ERP - Purchase Management System (Standalone Desktop Application)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend",
    "frontend": "cd frontend && npm run dev",
    "backend": "node backend/server.js",
    "dev": "concurrently \"npm run backend\" \"cd frontend && npm run dev -- --host 0.0.0.0 --port 3000\"",
    "start": "node backend/server.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "cd frontend && npm run lint"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.5.0",
    "@types/node": "^25.9.2"
  },
  "author": "",
  "license": "MIT"
}
