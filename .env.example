# BVC ERP Environment Configuration

# Application Port (Defaults to 3000)
PORT=3000

# Environment Mode (development / production)
NODE_ENV=development

# Database Connection (Neon PostgreSQL / External Cloud Postgres)
# Leave blank for local offline multi-tenant SQLite mode
DATABASE_URL=

# JSON Web Token Secret Key
JWT_SECRET=bvc-erp-secure-jwt-secret-key-2026

# Frontend API URL (if frontend hosted separately)
VITE_API_URL=
